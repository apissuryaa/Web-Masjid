# ============================================================
# Template Environment Variables untuk Web-Masjid
# ============================================================
# CARA PAKAI DI PYTHONANYWHERE:
# 1. Copy file ini ke server PythonAnywhere
# 2. Rename menjadi .env (tanpa kata "example")
# 3. Isi nilai-nilai di bawah dengan data yang sebenarnya
# 4. JANGAN commit file .env ke GitHub!
# ============================================================

# --- Django Security ---
SECRET_KEY=ganti-dengan-random-string-panjang-minimal-50-karakter
DEBUG=False

# --- Database (Supabase PostgreSQL) ---
# Ambil dari: Supabase Dashboard → Project Overview → tombol Copy → Direct connection string
# Ganti [YOUR-PASSWORD] dengan password database Supabase Anda
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Media Files ---
# Di PythonAnywhere, file disimpan lokal (tidak perlu Supabase Storage)
USE_SUPABASE_STORAGE=False

# --- Supabase Storage (opsional, isi jika USE_SUPABASE_STORAGE=True) ---
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_S3_KEY=your-access-key-id
# SUPABASE_S3_SECRET=your-secret-access-key
# SUPABASE_BUCKET=media
# SUPABASE_REGION=ap-southeast-1
